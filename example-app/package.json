{
  "name": "@shutter-studio/live-session-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local Parakeet host-caption CLI using the Live Session SDK",
  "license": "Apache-2.0",
  "bin": { "live-session": "./dist/cli.js" },
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/browser-entry.ts --bundle --platform=browser --format=iife --target=chrome120 --outfile=dist/browser.js --log-level=warning",
    "prestart": "npm run build --workspace @shutter-studio/live-session-sdk && npm run build",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@shutter-studio/live-session-sdk": "0.1.0",
    "ws": "^8.23.0"
  },
  "optionalDependencies": {
    "sherpa-onnx-node": "2.0.1"
  }
}
