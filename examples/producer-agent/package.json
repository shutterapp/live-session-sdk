{
  "name": "@shutter-studio/producer-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/browser-entry.ts --bundle --platform=browser --format=iife --target=chrome120 --outfile=dist/browser.js --log-level=warning",
    "prestart": "npm run build -w @shutter-studio/live-session-sdk && npm run build -w @shutter-studio/caption-media && npm run build",
    "start": "node --env-file=../.env producer-agent.mjs"
  },
  "dependencies": {
    "@shutter-studio/live-session-sdk": "0.1.0",
    "@shutter-studio/caption-media": "0.1.0"
  }
}
