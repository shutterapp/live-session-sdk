{
  "name": "live-session-sdk-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Live Session SDK and standalone example CLI",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/shutterapp/live-session-sdk.git"
  },
  "workspaces": [
    "sdk",
    "examples/assistant-agent",
    "examples/caption-media",
    "examples/producer-agent"
  ],
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "build": "npm run build -w sdk -w examples/caption-media -w examples/assistant-agent -w examples/producer-agent",
    "test": "npm run test -w sdk",
    "start": "npm run start -w examples/assistant-agent --",
    "install:chromium": "playwright install chromium",
    "secrets:scan": "betterleaks dir . --config .betterleaks.toml --redact --validation=false",
    "secrets:history": "betterleaks git . --config .betterleaks.toml --redact --validation=false",
    "secrets:staged": "betterleaks git . --pre-commit --staged --config .betterleaks.toml --redact --validation=false",
    "hooks:install": "git config --local core.hooksPath .githooks",
    "producer": "npm start -w examples/producer-agent --"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "typescript": "~5.8.3",
    "ws": "^8.18.0"
  }
}
